; FSOT Circuit array — SMT bounds (Z3 / CVC5). Linear arithmetic only.
; Frozen numbers from results/sim_report.json (pin AEB2AD, branch fix/aeb2ad-long-window:
; 2000-tau window, no clip, amplitude-checked lock, Branch L gamma).

(set-logic QF_LRA)

(declare-const phi Real)
(declare-const Rc_phi_sq Real)
(declare-const bom_residual_pct Real)
(declare-const lock_rate_phi_sq Real)
(declare-const lock_rate_open Real)
(declare-const lock_rate_sigma1 Real)
(declare-const lock_rate_rc20k Real)
(declare-const sigma_c_pred Real)
(declare-const sigma_c_sweep Real)
(declare-const r0_ohm Real)

(assert (= phi 1.618033988749895))
(assert (= Rc_phi_sq 6875.388202501893))
(assert (= bom_residual_pct 0.03822914280382551))
(assert (= lock_rate_phi_sq 1.0))
(assert (= lock_rate_open 0.0))
(assert (= lock_rate_sigma1 0.0))
(assert (= lock_rate_rc20k 0.0))
(assert (= sigma_c_pred 1.4897))
(assert (= sigma_c_sweep 1.525))
(assert (= r0_ohm 18.44004975928614))

(assert (> phi 1.6))
(assert (< phi 1.62))
(assert (> Rc_phi_sq 6870.0))
(assert (< Rc_phi_sq 6880.0))
(assert (< bom_residual_pct 0.5))
(assert (>= bom_residual_pct 0.0))
(assert (= lock_rate_phi_sq 1.0))
(assert (= lock_rate_open 0.0))
(assert (= lock_rate_sigma1 0.0))
(assert (= lock_rate_rc20k 0.0))
; sharp prediction: |sigma_c_sweep - sigma_c_pred| <= 0.05, and sigma_c < phi (so sigma = phi must lock)
(assert (<= (- sigma_c_sweep sigma_c_pred) 0.05))
(assert (<= (- sigma_c_pred sigma_c_sweep) 0.05))
(assert (< sigma_c_pred phi))
(assert (> r0_ohm 0.0))

(check-sat)
(get-value (phi Rc_phi_sq bom_residual_pct lock_rate_phi_sq sigma_c_pred sigma_c_sweep))
